# Environment variables for the shop functions (netlify/functions).
# Set the real values in Netlify: Site configuration > Environment variables.
# Never commit real values; .env is gitignored for local testing with `netlify dev`.

# Google Sheet built from Poppas_Calligraphy_Master_Inventory.xlsx.
# The ID is the long string in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# Service account from Google Cloud. Share the sheet with this email as an EDITOR
# (Viewer is not enough: the Stripe webhook writes stock back to the Easy Edit tab).
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The "private_key" value from the service account's JSON key file, including the
# BEGIN/END lines. Pasting it with literal \n line breaks is fine.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Stripe Dashboard > Developers > API keys. Use sk_test_... until test purchases pass.
STRIPE_SECRET_KEY=

# Stripe Dashboard > Developers > Webhooks > add endpoint:
#   URL:    https://<your-site>/.netlify/functions/stripe-webhook
#   Events: checkout.session.completed
# Then copy that endpoint's signing secret (whsec_...). Test and live mode have different secrets.
STRIPE_WEBHOOK_SECRET=
